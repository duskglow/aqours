-ifneq (,$(filter i386 amd64,$(DEB_HOST_ARCH_CPU)))
+# Yohane: amd64 builds only 64-bit UEFI (no 32-bit x86 platforms), so that is the common platform.
+ifeq (amd64,$(DEB_HOST_ARCH_CPU))
+COMMON_PLATFORM := efi-amd64
+else ifeq (i386,$(DEB_HOST_ARCH_CPU))
 COMMON_PLATFORM := pc
 else ifneq (,$(filter powerpc ppc64 ppc64el sparc sparc64,$(DEB_HOST_ARCH_CPU)))
 COMMON_PLATFORM := ieee1275
