#!/bin/bash
# buildone: build one source package on this build host and report the result.
#
#   tools/buildone STAGE SOURCE VERSION
#
# Runs sbuild (unshare mode, through the host's `slots` queue), keeps the log
# and .buildinfo in $AQOURS_LOGS/STAGE/, deletes the build tree and outputs, and
# prints one result line last:
#   RESULT <ok|fail|hang|error> <seconds> <failstage> <log path>
# Stage "stage0" is the glibc reference rebuild: architecture-dependent
# binaries only (Architecture: all is imported, not rebuilt), with the
# package's own build-time tests on. Nothing from stage0 is published.
# Stage "stage0p" is the same with Aqours's patches applied (packages/<source>/).
# Needs ~/aqours/env (AQOURS_CHROOT, AQOURS_SCRATCH, AQOURS_LOGS, SBUILD_CONFIG, ...).
set -uo pipefail
STAGE=${1:?usage: buildone STAGE SOURCE VERSION}; SRC=${2:?}; VER=${3:?}

# Builds are started detached from a short SSH command. Their inherited session
# keyring belongs to that SSH login, and PAM (pam_keyinit "force revoke")
# revokes it when the login ends, so tests that use the session keyring (krb5's
# t_cccol.py) would fail. Run every build in a fresh anonymous session keyring.
if [ -z "${AQOURS_OWN_KEYRING:-}" ] && command -v keyctl >/dev/null; then
  export AQOURS_OWN_KEYRING=1
  exec keyctl session - "$0" "$@"
fi
. "$HOME/aqours/env"
: "${AQOURS_LOGS:?set AQOURS_LOGS}" "${AQOURS_CHROOT:?}" "${AQOURS_SCRATCH:?}"

# Sources whose build trees don't fit in RAM scratch build on local disk.
case "$SRC" in
  gcc-1[0-9]|glibc|llvm-toolchain-*|rustc|rust-*|linux|firefox-esr|thunderbird|libreoffice|openjdk-*|qtwebengine-*|chromium|webkit2gtk|mesa|python3.1[0-9]|binutils|systemd|perl)
    export AQOURS_SCRATCH=${AQOURS_SCRATCH_DISK:-$AQOURS_SCRATCH};;
esac
# The slots reservation. Most builds spend long stretches single-threaded
# (configure, tests, packaging), so ordinary sources reserve a small share and
# the queue packs more of them per host; only the giants reserve a lot.
case "$SRC" in
  rust-*|rustc|llvm-toolchain-*|gcc-1[0-9]|glibc|linux|libreoffice|firefox-esr|chromium) SIZE=L;;
  binutils|systemd|perl|python3.1[0-9]|openssl|util-linux|gnutls28|krb5|bind9|vim|grub2|elfutils|gnupg2|apparmor|exim4|openssh) SIZE=M;;
  *) SIZE=S;;
esac

work="$HOME/aqours/out/$STAGE/${SRC}_${VER}"
logdir="$AQOURS_LOGS/$STAGE"
rm -rf "$work"; mkdir -p "$work" "$logdir"
rm -f "$logdir/${SRC}_${VER}.result"
cd "$work" || exit 1

case "$STAGE" in
  stage0)  opts=(--no-arch-all --arch-any); dbo="noautodbgsym"; patches=no;;   # pure baseline: Devuan as is
  stage0p) opts=(--no-arch-all --arch-any); dbo="noautodbgsym"; patches=yes;;  # baseline + Aqours patches (glibc)
  *) echo "RESULT error 0 - unknown-stage"; exit 2;;
esac

# Aqours patches: packages/<source>/patches/*.patch from the Aqours repository,
# applied in name order to the verified Devuan source. The result is rebuilt as
# a new source package with version <version>aqours<N> (N from
# packages/<source>/revision, default 1), and that is what sbuild builds.
target="${SRC}_${VER}"
pkgdir="${AQOURS_PACKAGES:-}/$SRC"
if [ "$patches" = yes ] && [ -n "${AQOURS_PACKAGES:-}" ] && ls "$pkgdir"/patches/*.patch >/dev/null 2>&1; then
  prep="$logdir/${SRC}_${VER}.prep.log"
  rev=$(cat "$pkgdir/revision" 2>/dev/null || echo 1)
  newver="${VER}aqours${rev}"
  (
    set -e
    echo "== getsource $SRC $VER"
    dsc=$(python3 -I "$HOME/aqours/tools/getsource" "$SRC" "$VER" "$work/src")
    cd "$work/src"
    dpkg-source --no-check -x "$dsc" tree      # the .dsc's files were verified by getsource
    for p in "$pkgdir"/patches/*.patch; do
      echo "== apply $(basename "$p")"
      patch -p1 -d tree --no-backup-if-mismatch < "$p"
    done
    (cd tree && DEBEMAIL="aqours@koiren.ai" DEBFULLNAME="Aqours Maintainers" \
      dch --newversion "$newver" --distribution excalibur --force-distribution \
          "Aqours: apply packages/$SRC patches: $(cd "$pkgdir/patches" && ls *.patch | tr '\n' ' ')")
    dpkg-source --auto-commit -b tree
  ) > "$prep" 2>&1
  prc=$?
  target="$work/src/${SRC}_${newver#*:}.dsc"
  if [ $prc -ne 0 ] || [ ! -f "$target" ]; then
    zstd -q -f "$prep" -o "$prep.zst" && rm -f "$prep"
    cd /; rm -rf "$work"
    line="RESULT fail 0 aqours-patch $prep.zst"
    echo "$line" > "$logdir/${SRC}_${VER}.result"; echo "$line"; exit 0
  fi
  zstd -q -f "$prep" -o "$prep.zst" && rm -f "$prep"   # keep the record of what was applied
  cd "$work"
fi
jobs=${AQOURS_JOBS:-8}
case "$SIZE" in S) jobs=$(( (jobs + 1) / 2 ));; L) jobs=$((jobs * 2));; esac
export DEB_BUILD_OPTIONS="parallel=$jobs $dbo"

start=$SECONDS
# slots caps a shared job's run time (SLOT_MAX_MIN, default 150 minutes), and
# gcc or binutils with their test suites run longer. Our own backstop below is
# the only time limit, so lift the queue's cap just above it.
backstop_h=${AQOURS_BUILD_BACKSTOP_H:-8}
# gcc's test suite runs in three configurations (default, -fstack-protector,
# -m32) and takes far longer than any other package; give it its own backstop.
case "$SRC" in gcc-1[0-9]) backstop_h=${AQOURS_GCC_BACKSTOP_H:-24};; esac
# slots pins each job to a block of cores (it serves timing runs too). Builds
# need no pinning, and some test suites assume CPU 0 is in their affinity mask
# (libuv's thread_affinity), so pinning makes results depend on which block a
# job got. A no-op pin helper leaves builds unpinned; the queue still counts cores.
export SLOT_PIN_BIN=/bin/true
SLOT_MAX_MIN=$(( backstop_h * 60 + 15 )) SLOT_SIZE=$SIZE "$HOME/bin/slots" 1 "aqours:$STAGE:$SRC" \
  timeout --kill-after=5m "${backstop_h}h" \
  sbuild --chroot="$AQOURS_CHROOT" --dist=excalibur "${opts[@]}" "$target" >/dev/null 2>&1
rc=$?
secs=$((SECONDS - start))

log=$(ls -t "$work"/*.build 2>/dev/null | grep -v '_amd64.build$' | head -1)
[ -n "$log" ] || log=$(ls -t "$work"/*.build 2>/dev/null | head -1)
failstage=$(grep -a -m1 '^Fail-Stage:' "$log" 2>/dev/null | awk '{print $2}')
# Report sbuild's own job time (Package-Time) rather than wall time, which
# also counts waiting in the slots queue. Fall back to wall time with no log.
ptime=$(grep -a -m1 '^Package-Time:' "$log" 2>/dev/null | awk '{print $2}')
[ -n "$ptime" ] && secs=$ptime
status=$(grep -a -m1 '^Status:' "$log" 2>/dev/null | awk '{print $2}')
dest="$logdir/${SRC}_${VER}.log.zst"
[ -n "$log" ] && zstd -q -f -19 "$log" -o "$dest"
cp -f "$work"/*.buildinfo "$logdir/" 2>/dev/null

if [ $rc -eq 124 ] || [ $rc -eq 137 ]; then res=hang
elif [ "$status" = successful ] && [ $rc -eq 0 ]; then res=ok
elif [ -n "$log" ]; then res=fail
else res=error; fi

cd /; rm -rf "$work"
line="RESULT $res $secs ${failstage:--} $dest"
# Also leave the result beside the log, so a restarted driver can pick it up.
echo "$line" > "$logdir/${SRC}_${VER}.result.tmp" && mv -f "$logdir/${SRC}_${VER}.result.tmp" "$logdir/${SRC}_${VER}.result"
echo "$line"
