#!/bin/bash
# mkimage: build a bootable test image (ext4 root, plus the kernel and initrd
# beside it for direct boot), unprivileged.
#
#   tools/mkimage --mirror URL [--suite SUITE] [--keyrings DIR] OUTDIR
#
# OUTDIR gets root.ext4, vmlinuz and initrd.img. The image boots sysvinit with
# a serial console. A boot-test init script (rc2.d, last) prints
#   YOHANE-BOOTTEST: OK <uname -r> runlevel=<n> libc=<libc.so.6 target>
# on the console and powers off, so tools/boottest has a deterministic signal.
#
# mke2fs -d runs inside mmdebstrap's user namespace, where the root tree's
# files are owned by root, so the image's ownership is right without real root.
# During hooks mmdebstrap bind-mounts the host's /dev, /dev/shm, /proc and /sys
# into the tree, so the tree is first copied with tar --one-file-system (which
# skips every mount) and mke2fs reads the copy. /dev is left empty: device
# nodes can't be made in a user namespace, and the booted kernel's devtmpfs
# and eudev provide them.
set -euo pipefail

MIRROR=${YOHANE_MIRROR:-}
KEYRINGS=${YOHANE_KEYRINGS:-}
SUITE=excalibur
EXTRA_SOURCES=""
INCLUDE="init,sysvinit-core,eudev,kmod,e2fsprogs,linux-image-amd64,initramfs-tools,procps,iproute2"
EXTRA_KEYRINGS=()
CHECKS=()
while [ $# -gt 1 ]; do
  case "$1" in
    --mirror) MIRROR=$2; shift 2;;
    --suite) SUITE=$2; shift 2;;
    --keyrings) KEYRINGS=$2; shift 2;;
    --source) EXTRA_SOURCES+="$2"$'\n'; shift 2;;   # an extra full sources line
    --include) INCLUDE+=",$2"; shift 2;;
    --keyring-file) EXTRA_KEYRINGS+=("$2"); shift 2;;  # another archive keyring to trust (e.g. Yohane's)
    --check) CHECKS+=("$2"); shift 2;;            # a boot check script, run by the boot-test init script
    *) echo "unknown option: $1" >&2; exit 2;;
  esac
done
OUTDIR=${1:?usage: mkimage --mirror URL [--suite S] [--source LINE] [--include PKGS] OUTDIR}
[ -n "$MIRROR" ] || { echo "mkimage: set --mirror or YOHANE_MIRROR" >&2; exit 2; }
[ -n "$KEYRINGS" ] || { echo "mkimage: set --keyrings or YOHANE_KEYRINGS" >&2; exit 2; }
KR="$KEYRINGS/devuan-archive-keyring.gpg"

mkdir -p "$OUTDIR"
OUTDIR=$(cd "$OUTDIR" && pwd)
# The namespace's mapped root writes the outputs into a world-writable staging
# directory; we move them into OUTDIR afterwards.
STAGE=$(mktemp -d "$OUTDIR/.stage.XXXXXX")
chmod 1777 "$STAGE"
trap 'rm -rf "$STAGE"' EXIT

SOURCES="deb $MIRROR $SUITE main
deb $MIRROR $SUITE-updates main
deb $MIRROR $SUITE-security main
$EXTRA_SOURCES"

BOOTTEST='#!/bin/sh
### BEGIN INIT INFO
# Provides:          yohane-boottest
# Required-Start:    $all
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:
# Short-Description: Yohane boot test marker
### END INIT INFO
case "$1" in start)
  for c in /etc/yohane-boottest.d/*; do
    [ -f "$c" ] || continue
    sh "$c" > /dev/ttyS0 2>&1 || echo "YOHANE-CHECK: $(basename "$c") FAIL (exit $?)" > /dev/ttyS0
  done
  rl=$(runlevel | cut -d" " -f2)
  libc=$(readlink -f /lib/x86_64-linux-gnu/libc.so.6 2>/dev/null || echo none)
  echo "YOHANE-BOOTTEST: OK $(uname -r) runlevel=$rl libc=$libc" > /dev/ttyS0
  if grep -qw yohane.boottest=poweroff /proc/cmdline; then poweroff; fi;;
esac
exit 0'

# Boot checks are copied through the staging directory, which the namespace's
# mapped root can read (it can't enter a mode-750 home directory).
mkdir -p "$STAGE/checks"; chmod 755 "$STAGE/checks"
for c in "${CHECKS[@]}"; do cp "$c" "$STAGE/checks/"; done
chmod 644 "$STAGE"/checks/* 2>/dev/null || true
# mmdebstrap takes one --keyring (a later one replaces an earlier one), so all
# trusted keyrings are gathered into one directory, which apt reads as trusted
# parts, and the same files are installed in the image.
mkdir -p "$STAGE/keyrings"; chmod 755 "$STAGE/keyrings"
cp "$KR" "$STAGE/keyrings/"
for k in "${EXTRA_KEYRINGS[@]}"; do cp "$k" "$STAGE/keyrings/"; done
chmod 644 "$STAGE"/keyrings/*
keyopts=(--keyring="$STAGE/keyrings")
keyhooks=(--customize-hook="mkdir -p \"\$1/etc/apt/trusted.gpg.d\" && cp \"$STAGE\"/keyrings/*.gpg \"\$1/etc/apt/trusted.gpg.d/\"")

mmdebstrap --mode=unshare --variant=minbase --format=null \
  "${keyopts[@]}" \
  --include="$INCLUDE" \
  "${keyhooks[@]}" \
  --customize-hook="mkdir -p \"\$1/etc/yohane-boottest.d\" && cp \"$STAGE\"/checks/* \"\$1/etc/yohane-boottest.d/\" 2>/dev/null; true" \
  --customize-hook="printf '%s\n' '$BOOTTEST' > \"\$1/etc/init.d/yohane-boottest\" && chmod 755 \"\$1/etc/init.d/yohane-boottest\"" \
  --customize-hook='chroot "$1" update-rc.d yohane-boottest defaults >/dev/null' \
  --customize-hook='echo "T0:23:respawn:/sbin/getty -L ttyS0 115200 vt100" >> "$1/etc/inittab"' \
  --customize-hook='echo "/dev/vda / ext4 errors=remount-ro 0 1" > "$1/etc/fstab"; echo yohane-test > "$1/etc/hostname"' \
  --customize-hook='rm -f "$1"/var/cache/apt/*.bin; rm -rf "$1"/var/lib/apt/lists/*' \
  --customize-hook="cp -L \"\$1\"/vmlinuz \"$STAGE/vmlinuz\" && cp -L \"\$1\"/initrd.img \"$STAGE/initrd.img\"" \
  --customize-hook="{ mkdir \"$STAGE/tree\" && tar -C \"\$1\" --one-file-system --exclude=./dev/* -cf - . | tar -C \"$STAGE/tree\" -xpf - && sz=\$(du -sm \"$STAGE/tree\" | cut -f1) && mke2fs -q -t ext4 -L yohane-root -d \"$STAGE/tree\" \"$STAGE/root.ext4\" \$(( sz * 13 / 10 + 256 ))M; } 2>\"$STAGE/hook.log\"; rc=\$?; rm -rf \"$STAGE/tree\"; exit \$rc" \
  "$SUITE" /dev/null - <<<"$SOURCES" || { echo "mkimage: mmdebstrap failed; image hook said:" >&2; cat "$STAGE/hook.log" >&2 2>/dev/null; exit 1; }

for f in root.ext4 vmlinuz initrd.img; do mv -f "$STAGE/$f" "$OUTDIR/$f"; done
echo "mkimage: wrote $OUTDIR (root.ext4 $(du -h "$OUTDIR/root.ext4" | cut -f1))"
